{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@dietrichgebert/ponytail"],
  "provider": {
    "agentgw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agent Gateway",
      "options": {
        "baseURL": "https://inference.ai.home.timosur.com/v1",
        "apiKey": "{env:AGENTGATEWAY_INFERENCE_API_KEY}",
      },
      "models": {
        "qwen3-5-0-8b": {
          "name": "Qwen 3.5 0.8B (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "qwen3-5-9b": {
          "name": "Qwen 3.5 9B (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "qwen3-8-27b": {
          "name": "Qwen 3.8 27B (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "mythos-9b-unhinged": {
          "name": "Mythos 9B Unhinged (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "claude-fable-5-1": {"name": "Claude Fable 5.1 (Anthropic)"},
        "gpt-5-6-luna": {"name": "GPT-5.6 Luna (OpenAI)"},
        "gpt-5-6-sol-terra": {"name": "GPT-5.6 Sol Terra (OpenAI)"}
      },
    }
  },
  "agent": {
    "local": {
      "mode": "primary",
      "description": "Read-only local Bonsai agent for small codebase questions.",
      "model": "agentgw/qwen3-5-9b",
      "steps": 3,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "title": {
      "model": "agentgw/qwen3-5-0-8b"
    },
    "compaction": {
      "model": "agentgw/qwen3-5-0-8b"
    }
  },
  "mcp": {
{{- if hasSuffix "@rwe.com" .email }}
    "ado": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@azure-devops/mcp", "RWE-Renewables", "-a", "azcli"]
    },
{{- end }}
    "gopls": {
      "type": "local",
      "enabled": false,
      "command": ["gopls", "mcp"]
    },
    "code-runner": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "mcp-server-code-runner@latest"]
    }
  },
  "lsp": {
{{- if hasSuffix "@rwe.com" .email }}
    "csharp": {
      "disabled": false,
      "command": ["csharp-ls"],
    },
{{- end }}
  }
}
