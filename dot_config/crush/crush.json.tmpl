{{- $enpass := findOneExecutable "enpass-cli" "enpasscli" -}}
{{- $enpassVault := .enpassVault -}}
{{- $agentGateway := output $enpass "-vault" $enpassVault "pass" "AgentGateway" | trim -}}
{
  "$schema": "https://charm.land/crush.json",
  "lsp": {
    "go": {
      "command": "gopls"
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "stdio",
      "command": "docker",
      "args": [
          "run",
          "--rm",
          "-i",
          "mcp/sequentialthinking"
        ]
    }
  },
  "providers": {
    "agentgw": {
      "name": "Agent Gateway",
      "type": "openai-compat",
      "base_url": "https://inference.ai.home.timosur.com/v1",
      "api_key": "{{ $agentGateway }}",
      "models": [
        {
          "id": "bonsai-27b",
          "name": "Bonsai 27B (Ollama)"
        },
        {
          "id": "claude-fable-5-1",
          "name": "Claude Fable 5.1 (Anthropic)"
        },
        {
          "id": "gpt-5-6-luna",
          "name": "GPT-5.6 Luna (OpenAI)"
        },
        {
          "id": "gpt-5-6-sol-terra",
          "name": "GPT-5.6 Sol Terra (OpenAI)"
        }
      ]
    }
  }
}
