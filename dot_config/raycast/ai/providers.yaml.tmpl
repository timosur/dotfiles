providers:
  - id: agentgw
    name: Agent Gateway
    base_url: https://inference.ai.home.timosur.com/v1
    api_keys:
      agentgw: '{{ (rbw "AgentGateway").data.password }}'
    additional_parameters:
      return_images: false
    # Specify all models to use with the current provider
    models:
      - id: qwen3-5-0-8b
        name: Qwen 3.5 0.8B (Ollama)
        provider: agentgw
      - id: qwen3-5-9b
        name: Qwen 3.5 9B (Ollama)
        provider: agentgw
      - id: qwen3-8-27b
        name: Qwen 3.8 27B (Ollama)
        provider: agentgw
      - id: qwythos-9b-abliterated
        name: Qwythos 9B Abliterated (Ollama)
        provider: agentgw
      - id: claude-fable-5-1
        name: Claude Fable 5.1 (Anthropic)
        provider: agentgw
      - id: gpt-5-6-luna
        name: GPT-5.6 Luna (OpenAI)
        provider: agentgw
      - id: gpt-5-6-sol-terra
        name: GPT-5.6 Sol Terra (OpenAI)
        provider: agentgw
