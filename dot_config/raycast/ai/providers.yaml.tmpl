{{- $enpass := findOneExecutable "enpass-cli" "enpasscli" -}}
{{- $enpassVault := .enpassVault -}}
{{- $agentGateway := output "sh" "-c" (printf "%s -vault %s -json -detailed show %s | jq -r '.[] | select(.title == %s) | .fields[] | select(.label == %s) | .value'" $enpass (shellQuote $enpassVault) (shellQuote "AgentGateway") (shellQuote "AgentGateway") (shellQuote "prskr")) | trim -}}
providers:
  - id: agentgw
    name: Agent Gateway
    base_url: https://agentgw.priv.icb4dc0.de/v1
    api_keys:
      agentgw: '{{ $agentGateway }}'
    additional_parameters:
      return_images: false
    # Specify all models to use with the current provider
    models:
      - id: gemini-3.1-flash-lite
        name: Gemini 3.1 Flash Lite
        provider: agentgw
        context: 1048576
        abilities:
          temperature:
            supported: true
          vision:
            supported: true
