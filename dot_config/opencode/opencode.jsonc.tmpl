{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["opencode-history-search", "@dietrichgebert/ponytail"],
  "provider": {
    "azure": {
      "models": {
        "gpt-5.6-terra-VSCode": {
          "name": "gpt-5.6-terra"
        }
      }
    },
    "agentgateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agent Gateway",
      "options": {
        "baseURL": "https://inference.ai.home.timosur.com/v1",
        "apiKey": "{env:AGENTGATEWAY_INFERENCE_API_KEY}",
      },
      "models": {
        "qwen3-5-0-8b": {
          "name": "Qwen 3.5 0.8B (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "qwen3-5-9b": {
          "name": "Qwen 3.5 9B (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "qwen3-8-27b": {
          "name": "Qwen 3.8 27B (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "mythos-9b-unhinged": {
          "name": "Mythos 9B Unhinged (Ollama)",
          "temperature": true,
          "modalities": {"input": ["text"], "output": ["text"]},
          "limit": {"context": 8192, "input": 7680, "output": 512}
        },
        "claude-fable-5-1": {"name": "Claude Fable 5.1 (Anthropic)"},
        "gpt-5-6-luna": {"name": "GPT-5.6 Luna (OpenAI)"},
        "gpt-5-6-sol-terra": {"name": "GPT-5.6 Sol Terra (OpenAI)"}
      },
    }
  },
  "model": "github-copilot/gpt-5.6-terra",
  "agent": {
    "title": {
      "model": "agentgateway/qwen3-5-0-8b"
    },
  },
  "mcp": {
{{- if hasSuffix "@rwe.com" .email }}
    "ado": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@azure-devops/mcp", "RWE-Renewables", "-a", "azcli"]
    },
{{- end }}
    "agentgateway": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.ai.home.timosur.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:AGENTGATEWAY_INFERENCE_API_KEY}"
      }
    },
    "gopls": {
      "type": "local",
      "enabled": false,
      "command": ["gopls", "mcp"]
    },
    "code-runner": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "mcp-server-code-runner@latest"]
    }
  },
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "*rtk npx ctx7@latest *": "allow",
      "*rtk git add*": "allow",
      "*rtk git diff*": "allow",
      "*rtk git status*": "allow",
      "*rtk git log*": "allow",
      "*rtk git branch*": "allow",
      "*docker inspect*": "ask"
    },
    "read": {
      ".env": "ask",
      "**/.env": "ask",
      "*.env": "ask",
      "**/*.env": "ask",
      "*.env.*": "ask",
      "**/*.env.*": "ask"
    },
    "glob": {
      ".env": "ask",
      "**/.env": "ask",
      "*.env": "ask",
      "**/*.env": "ask",
      "*.env.*": "ask",
      "**/*.env.*": "ask"
    },
    "grep": {
      ".env": "ask",
      "**/.env": "ask",
      "*.env": "ask",
      "**/*.env": "ask",
      "*.env.*": "ask",
      "**/*.env.*": "ask"
    }
  }
}
