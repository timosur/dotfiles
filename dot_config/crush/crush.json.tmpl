{
  "$schema": "https://charm.land/crush.json",
  "lsp": {
    "go": {
      "command": "gopls"
    }
  },
  "mcp": {
{{- if hasSuffix "@rwe.com" .email }}
    "ado": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "RWE-Renewables",
        "-a",
        "azcli"
      ]
    },
{{- end }}
    "gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": ["mcp"],
      "disabled": true
    },
    "code-runner": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-code-runner@latest"],
      "disabled": true
    }
  },
  "providers": {
    "agentgw": {
      "name": "Agent Gateway",
      "type": "openai-compat",
      "base_url": "https://inference.ai.home.timosur.com/v1",
      "api_key": "{{ (rbw "AgentGateway").data.password }}",
      "models": [
        {
          "id": "qwen3-5-0-8b",
          "name": "Qwen 3.5 0.8B (Ollama)"
        },
        {
          "id": "qwen3-5-9b",
          "name": "Qwen 3.5 9B (Ollama)"
        },
        {
          "id": "qwen3-8-27b",
          "name": "Qwen 3.8 27B (Ollama)"
        },
        {
          "id": "mythos-9b-unhinged",
          "name": "Mythos 9B Unhinged (Ollama)"
        },
        {
          "id": "claude-fable-5-1",
          "name": "Claude Fable 5.1 (Anthropic)"
        },
        {
          "id": "gpt-5-6-luna",
          "name": "GPT-5.6 Luna (OpenAI)"
        },
        {
          "id": "gpt-5-6-sol-terra",
          "name": "GPT-5.6 Sol Terra (OpenAI)"
        },
      ]
    }
  }
}
