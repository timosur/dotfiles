{{- $enpass := findOneExecutable "enpass-cli" "enpasscli" -}}
{{- $enpassVault := .enpassVault -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@dietrichgebert/ponytail"],
  "provider": {
    "agentgw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agent Gateway",
      "options": {
        "baseURL": "https://inference.ai.home.timosur.com/v1",
      },
      "models": {
        "bonsai-27b": {
          "name": "Bonsai 27B (Ollama)"
        },
        "claude-fable-5-1": {
          "name": "Claude Fable 5.1 (Anthropic)"
        },
        "gpt-5-6-luna": {
          "name": "GPT-5.6 Luna (OpenAI)"
        },
        "gpt-5-6-sol-terra": {
          "name": "GPT-5.6 Sol Terra (OpenAI)"
        }
      },
    }
  },
  "mcp": {
    "gopls": {
      "type": "local",
      "enabled": false,
      "command": ["gopls", "mcp"]
    },
    "code-runner": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "mcp-server-code-runner@latest"]
    }
  },
  "lsp": {
{{- if hasSuffix "@rwe.com" .email }}
    "csharp": {
      "disabled": false,
      "command": ["csharp-ls"],
    },
{{- end }}
  }
}
